# Copy to backend/.env for local uvicorn (loads from cwd)

DATABASE_URL=postgresql+asyncpg://bharatmarkets:bharatmarkets_dev@localhost:5432/bharatmarkets
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=100

# Gemini — paste your key here (never commit the real .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
