# ─── BharatMarkets Environment Variables ───────────────────────
# Copy this to .env and fill in the values

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=bharatmarkets
POSTGRES_PASSWORD=bharatmarkets_dev
POSTGRES_DB=bharatmarkets

# ─── Backend ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bharatmarkets:bharatmarkets_dev@db:5432/bharatmarkets
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# Gemini AI assistant (get a key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ─── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
